# Copy this file to .env.local (for running on your computer) or paste these into Vercel.
# Find them in Supabase: Project Settings -> API Keys (and Data API for the URL).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Secret / service_role key. Server-only. Never share it or put NEXT_PUBLIC_ in front of it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
